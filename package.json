{
  "name": "lecture-transcripts-extension",
  "version": "0.1.0",
  "private": true,
  "description": "Personal Chrome extension and local uploader for saving activated Leccap lecture transcripts.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build:extension",
    "build:extension": "node scripts/build-extension.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.326",
    "esbuild": "^0.25.5",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4"
  }
}
